{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "declaration": false,
    "types": ["vitest/globals", "node", "@playwright/test"]
  },
  "include": [
    "test/**/*.ts",
    "e2e/**/*.ts",
    "vitest.config.ts",
    "vite.config.ts",
    "vite.shared-config.ts",
    "playwright.config.ts"
  ]
}
