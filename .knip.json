{
	"$schema": "./node_modules/knip/schema.json",
	"ignoreBinaries": ["open"],
	"ignoreFiles": ["./apps/deno/test/*"],
	"workspaces": {
		"apps/*": {
			"entry": ["**/*.ts"],
			"project": "**/*.ts"
		},
		"packages/*": {
			"entry": ["src/index.ts"],
			"project": "**/*.ts"
		},
		"packages/pdf": {
			"entry": ["src/index.ts", "scratchpad/index.ts"],
			"project": "**/*.ts"
		}
	}
}
