{
  "name": "@chr33s/fontkit",
  "version": "1.1.0",
  "description": "An advanced font engine for Node and the browser",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.min.mjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run generate && tsc && npm run copy:shaper-data && tsdown && npm run copy:wasm",
    "clean": "rm -rf dist src/opentype/shapers/*.json src/opentype/shapers/*-data.js",
    "copy:shaper-data": "node ./scripts/copy-shaper-json.ts",
    "copy:wasm": "cp ../brotli/dist/brotli.wasm dist/brotli.wasm",
    "generate": "node src/opentype/shapers/generate-data.ts && node src/opentype/shapers/gen-use.ts && node src/opentype/shapers/gen-indic.ts",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "dependencies": {
    "@chr33s/brotli": "file:../brotli",
    "@chr33s/dfa": "file:../dfa",
    "@chr33s/restructure": "file:../restructure",
    "@chr33s/tiny-inflate": "file:../tiny-inflate",
    "@chr33s/unicode-properties": "file:../unicode-properties",
    "@chr33s/unicode-trie": "file:../unicode-trie",
    "base64-arraybuffer": "^1.0.2",
    "clone": "^2.1.2",
    "deep-equal": "^2.2.3",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@chr33s/codepoints": "file:../codepoints",
    "@types/clone": "^2.1.4",
    "@types/concat-stream": "^2.0.3",
    "@types/deep-equal": "^1.0.4",
    "@types/node": "^24.10.1",
    "@types/pako": "^2.0.4",
    "@vitest/coverage-v8": "^4.0.14",
    "concat-stream": "^2.0.0",
    "tsdown": "^0.16.7",
    "typescript": "^5.9.3",
    "vitest": "^4.0.12"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/Hopding/fontkit.git"
  },
  "keywords": [
    "opentype",
    "font",
    "typography",
    "subset",
    "emoji",
    "glyph",
    "layout"
  ],
  "author": "Andrew Dillon <andrew.dillon.j@gmail.com>",
  "contributors": [
    "Devon Govett <devongovett@gmail.com> (http://badassjs.com/)"
  ],
  "bugs": {
    "url": "https://github.com/Hopding/fontkit/issues"
  },
  "license": "MIT",
  "homepage": "https://github.com/Hopding/fontkit"
}
