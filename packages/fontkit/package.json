{
  "name": "@chr33s/fontkit",
  "version": "5.0.0",
  "description": "An advanced font engine for Node and the browser",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.min.mjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run generate && tsc && npm run copy:shaper-data && tsdown",
    "clean": "rm -rf dist src/opentype/shapers/*.json src/opentype/shapers/*-data.js src/opentype/shapers/*-data.d.ts",
    "copy:shaper-data": "node ./scripts/copy-shaper-json.ts",
    "generate": "node src/opentype/shapers/generate-data.ts && node src/opentype/shapers/gen-use.ts && node src/opentype/shapers/gen-indic.ts",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "dependencies": {
    "@chr33s/base64": "file:../base64",
    "@chr33s/brotli": "file:../brotli",
    "@chr33s/compression": "file:../compression",
    "@chr33s/dfa": "file:../dfa",
    "@chr33s/restructure": "file:../restructure",
    "@chr33s/unicode-properties": "file:../unicode-properties",
    "@chr33s/unicode-trie": "file:../unicode-trie",
    "clone": "2.1.2",
    "deep-equal": "2.2.3"
  },
  "devDependencies": {
    "@chr33s/codepoints": "file:../codepoints",
    "@types/clone": "2.1.4",
    "@types/deep-equal": "1.0.4",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.0.15",
    "tsdown": "0.17.0",
    "typescript": "5.9.3",
    "vitest": "4.0.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chr33s/pdf.git"
  },
  "keywords": [
    "opentype",
    "font",
    "typography",
    "subset",
    "emoji",
    "glyph",
    "layout"
  ],
  "author": "Andrew Dillon <andrew.dillon.j@gmail.com>",
  "contributors": [
    "Devon Govett <devongovett@gmail.com> (http://badassjs.com/)"
  ],
  "bugs": {
    "url": "https://github.com/chr33s/pdf/issues"
  },
  "license": "MIT",
  "homepage": "https://github.com/chr33s/pdf"
}
