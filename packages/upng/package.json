{
  "name": "@chr33s/pdf-upng",
  "license": "MIT",
  "version": "5.0.11",
  "description": "Small, fast and advanced PNG / APNG encoder and decoder",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/**",
    "src/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chr33s/pdf",
    "directory": "packages/upng"
  },
  "author": "photopea (https://github.com/photopea)",
  "contributors": [
    "Andrew Dillon (https://github.com/Hopding)",
    "Scimonster (https://github.com/Scimonster)"
  ],
  "bugs": {
    "url": "https://github.com/chr33s/pdf/issues"
  },
  "homepage": "https://github.com/chr33s/pdf",
  "keywords": [
    "png",
    "apng",
    "image",
    "conversion"
  ],
  "dependencies": {
    "@chr33s/pdf-common": "5.0.11"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
