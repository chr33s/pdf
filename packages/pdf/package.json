    "Phakorn Kiong (https://github.com/PhakornKiong)",
    "Donald Ness (https://github.com/programmarchy)"
  ],
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo scratchpad/build coverage tsBuildInfo.json apps/node-build apps/node/tsBuildInfo.json isolate*.log flamegraph.html out.pdf",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && open coverage/index.html",
    "build": "tsc && tsdown",
    "scratchpad:start": "tsc --build scratchpad/tsconfig.json --watch",
    "scratchpad:run": "node scratchpad/build/scratchpad/index.js",
    "scratchpad:flame": "rm -rf isolate*.log && node --prof scratchpad/build/scratchpad/index.js && node --prof-process --preprocess -j isolate*.log | flamebearer",
    "verify": "node scripts/verify-stream-fixtures.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.min.mjs",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@chr33s/compression": "file:../compression",
    "@chr33s/crypto": "file:../crypto",
    "@chr33s/standard-fonts": "file:../standard-fonts",
    "@chr33s/upng": "file:../upng",
    "color": "^5.0.3",
    "node-html-better-parser": ">=1.5.8"
  },
  "devDependencies": {
    "@chr33s/fontkit": "file:../fontkit",
    "@vitest/coverage-v8": "^4.0.12",
    "flamebearer": "^1.1.3",
    "tsdown": "^0.16.7",
    "typescript": "^5.9.3",
    "vitest": "^4.0.12"
  },
  "license": "MIT",
  "private": false,
  "homepage": "https://pdf.js.org",
  "repository": "git+https://github.com/cantoo-scribe/pdf.git",
  "bugs": {
    "url": "https://github.com/cantoo-scribe/pdf/issues"
  },
  "keywords": [
    "pdf",
    "pdf",
    "document",
    "create",
    "modify",
    "creation",
    "modification",
    "edit",
    "editing",
    "typescript",
    "javascript",
    "library"
  ]
}
