  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo scratchpad/build coverage tsBuildInfo.json apps/node-build apps/node/tsBuildInfo.json isolate*.log flamegraph.html out.pdf",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && open coverage/index.html",
    "build": "tsc && tsdown",
    "scratchpad:start": "tsc --build scratchpad/tsconfig.json --watch",
    "scratchpad:run": "node scratchpad/build/scratchpad/index.js",
    "scratchpad:flame": "rm -rf isolate*.log && node --prof scratchpad/build/scratchpad/index.js && node --prof-process --preprocess -j isolate*.log | flamebearer",
    "verify": "node scripts/verify-stream-fixtures.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.min.js",
      "import": "./dist/index.js"
    },
    "./bundle": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.bundle.js"
    }
  },
  "dependencies": {
    "@chr33s/pdf-common": "5.0.11",
    "@chr33s/pdf-standard-fonts": "5.0.11",
    "@chr33s/pdf-upng": "5.0.11",
    "color": "5.0.3",
    "node-html-better-parser": "1.5.9"
  },
  "devDependencies": {
    "@chr33s/pdf-fontkit": "5.0.11",
    "@vitest/coverage-v8": "4.1.10",
    "flamebearer": "2.1.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "unenv": "2.0.0-rc.24",
    "vitest": "4.1.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chr33s/pdf",
    "directory": "packages/pdf"
  },
  "bugs": {
    "url": "https://github.com/chr33s/pdf/issues"
  },
  "homepage": "https://github.com/chr33s/pdf",
  "keywords": [
    "pdf",
    "pdf",
    "document",
    "create",
    "modify",
    "creation",
    "modification",
    "edit",
    "editing",
    "typescript",
    "javascript",
    "library"
  ]
}
