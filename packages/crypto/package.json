{
  "name": "@chr33s/pdf-crypto",
  "description": "JavaScript library of crypto standards.",
  "version": "5.0.0",
  "type": "module",
  "author": {
    "name": "Evan Vosberg",
    "url": "http://github.com/evanvosberg"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chr33s/pdf.git"
  },
  "bugs": {
    "url": "https://github.com/chr33s/pdf/issues"
  },
  "homepage": "https://github.com/chr33s/pdf",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "keywords": [
    "security",
    "crypto",
    "Hash",
    "MD5",
    "SHA1",
    "SHA-1",
    "SHA256",
    "SHA-256",
    "RC4",
    "Rabbit",
    "AES",
    "DES",
    "PBKDF2",
    "HMAC",
    "OFB",
    "CFB",
    "CTR",
    "CBC",
    "Base64",
    "Base64url"
  ],
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.0.15"
  }
}
