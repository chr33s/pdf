{
  "name": "@chr33s/pdf-unicode-trie",
  "version": "5.1.1",
  "description": "Unicode Trie data structure for fast character metadata lookup, ported from ICU",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/**",
    "src/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chr33s/pdf",
    "directory": "packages/unicode-trie"
  },
  "author": "Devon Govett <devongovett@gmail.com>",
  "bugs": {
    "url": "https://github.com/chr33s/pdf/issues"
  },
  "license": "MIT",
  "homepage": "https://github.com/chr33s/pdf",
  "dependencies": {
    "@chr33s/pdf-common": "5.1.1"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
