{
  "name": "@chr33s/pdf-unicode-trie",
  "version": "5.0.3",
  "description": "Unicode Trie data structure for fast character metadata lookup, ported from ICU",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/**",
    "src/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chr33s/pdf.git"
  },
  "author": "Devon Govett <devongovett@gmail.com>",
  "bugs": {
    "url": "https://github.com/chr33s/pdf/issues"
  },
  "license": "MIT",
  "homepage": "https://github.com/chr33s/pdf",
  "dependencies": {
    "@chr33s/pdf-common": "5.0.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.0.15"
  }
}
