{
  "name": "@chr33s/brotli",
  "version": "3.0.0",
  "description": "A port of the Brotli compression algorithm as used in WOFF2",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "make && tsc && cp src/brotli.js src/brotli.wasm dist/",
    "clean": "rm -rf dist src/{brotli.d.ts,brotli.js,brotli.wasm}",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hopding/brotli.js.git"
  },
  "keywords": [
    "compress",
    "decompress",
    "encode",
    "decode"
  ],
  "author": "Andrew Dillon <andrew.dillon.j@gmail.com>",
  "contributors": [
    "Devon Govett <devongovett@gmail.com> (http://badassjs.com/)"
  ],
  "bugs": {
    "url": "https://github.com/Hopding/brotli.js/issues"
  },
  "license": "MIT",
  "homepage": "https://github.com/Hopding/brotli.js"
}
