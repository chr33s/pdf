{
  "name": "@chr33s/pdf-codepoints",
  "version": "5.1.0",
  "description": "A parser for files in the Unicode database",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/**",
    "src/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "update-data": "node scripts/update-data.ts",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "keywords": [
    "unicode",
    "ucd",
    "codepoint"
  ],
  "author": "Devon Govett <devongovett@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/chr33s/pdf",
    "directory": "packages/codepoints"
  },
  "bugs": {
    "url": "https://github.com/chr33s/pdf/issues"
  },
  "license": "MIT",
  "homepage": "https://github.com/chr33s/pdf",
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
