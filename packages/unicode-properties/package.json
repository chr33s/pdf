{
  "name": "@chr33s/pdf-unicode-properties",
  "version": "5.1.1",
  "description": "Provides fast access to unicode character properties",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/**",
    "src/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run clean && npm run generate && tsc",
    "clean": "rm -rf dist src/*.js src/*.d.ts",
    "generate": "node scripts/generate.ts",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "dependencies": {
    "@chr33s/pdf-common": "5.1.1",
    "@chr33s/pdf-unicode-trie": "5.1.1"
  },
  "devDependencies": {
    "@chr33s/pdf-codepoints": "5.1.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chr33s/pdf",
    "directory": "packages/unicode-properties"
  },
  "keywords": [
    "unicode",
    "metadata",
    "character",
    "codepoint"
  ],
  "author": "Andrew Dillon <andrew.dillon.j@gmail.com>",
  "contributors": [
    "Devon Govett <devongovett@gmail.com> (http://badassjs.com/)"
  ],
  "bugs": {
    "url": "https://github.com/chr33s/pdf/issues"
  },
  "license": "MIT",
  "homepage": "https://github.com/chr33s/pdf"
}
