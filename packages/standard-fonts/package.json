{
  "name": "@chr33s/standard-fonts",
  "version": "5.0.0",
  "description": "Metrics for the Standard 14 PDF fonts and their encodings",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run clean && npm run generate && tsc",
    "clean": "rm -rf dist {encoding-metrics,font-metrics,src}/*.json",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "generate": "npm run generate:fonts && npm run generate:encodings",
    "generate:fonts": "node scripts/fonts/parse.ts",
    "generate:encodings": "node scripts/encodings/parse.ts",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chr33s/pdf.git"
  },
  "keywords": [
    "afm",
    "adobe",
    "font",
    "metrics",
    "ascii",
    "pdf"
  ],
  "author": "Andrew Dillon <andrew.dillon.j@gmail.com>",
  "contributors": [
    "Christopher Brown <io@henrian.com> (http://henrian.com)"
  ],
  "bugs": {
    "url": "https://github.com/chr33s/pdf/issues"
  },
  "license": "MIT",
  "homepage": "https://github.com/chr33s/pdf",
  "dependencies": {
    "@chr33s/base64": "file:../base64",
    "@chr33s/compression": "file:../compression"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.12"
  }
}
