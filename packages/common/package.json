{
  "name": "@chr33s/pdf-common",
  "version": "5.0.7",
  "description": "Common pdf utilities and types",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/**",
    "src/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "author": "chr33s",
  "repository": {
    "type": "git",
    "url": "https://github.com/chr33s/pdf.git"
  },
  "bugs": {
    "url": "https://github.com/chr33s/pdf/issues"
  },
  "license": "MIT",
  "homepage": "https://github.com/chr33s/pdf",
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.0.15"
  }
}
